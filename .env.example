# Browser-visible map key. Restrict this key to your site origins in the map provider.
NEXT_PUBLIC_MAP_KEY=

# Optional server-only HTTPS endpoint that also receives each lead (leads are saved to the database either way).
# Do not prefix this variable with NEXT_PUBLIC_.
LEAD_WEBHOOK_URL=

# Facebook Page-to-blog integration. ALL values below are server-only.
# Never prefix these variables with NEXT_PUBLIC_. See docs/facebook-blog.md.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_APP_SECRET=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v26.0

# Password for the private /admin dashboard (visitors and leads). Server-only.
ADMIN_PASSWORD=

# Neon Postgres connection, added automatically by the Vercel Neon integration.
DATABASE_URL=

# Live Google reviews (Places API New). Server-only; restrict the key to the Places API.
# Find the Place ID with: node scripts/find-google-place-id.mjs
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
